    "settings.llm.voiceLanguageHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your primary spoken language. Select the language you use most often when recording voice messages. The AI model can recognize other languages too, but specifying your main language improves recognition quality."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это ваш основной язык, на котором вы разговариваете. Выберите тот язык, который используете чаще всего при записи голосовых сообщений. LLM-модель может распознавать и другие языки, но указание основного улучшает качество распознавания."
          }
        }
      }
    },
