    "settings.prompts.answerInFirstMessage.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When ON, the model may answer questions that appear inside the first voice-transcribed message. When OFF, the model only formats the text without answering or asking clarifying questions. This setting applies ONLY to the first voice message of a session — subsequent chat messages always work as a regular multi-turn conversation."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено — модель может ответить на вопросы, прозвучавшие внутри первого голосового сообщения. Если выключено — модель только отформатирует текст, не задаст уточнений и не ответит. Настройка действует ТОЛЬКО на первое голосовое сообщение сессии — последующие сообщения в чате всегда обрабатываются как обычный диалог."
          }
        }
      }
    },
